---
import type { Locale } from '../config/site';
import { dictionaries } from '../i18n/dictionaries';

interface Props {
  locale: Locale;
  // Base path without a trailing slash, e.g. "/zh", "/zh/archive", "/zh/tags/algorithm".
  basePath: string;
  currentPage: number;
  totalPages: number;
}

const { locale, basePath, currentPage, totalPages } = Astro.props;
const dictionary = dictionaries[locale];

// Page 1 lives at the clean base route; later pages live under /page/<n>/.
const pageHref = (page: number) => (page <= 1 ? `${basePath}/` : `${basePath}/page/${page}/`);
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;

const edgeLink =
  'underline-offset-4 text-zinc-600 transition-colors hover:text-zinc-900 hover:underline dark:text-zinc-400 dark:hover:text-zinc-100';
---

{totalPages > 1 && (
  <nav
    class="mt-12 flex items-center justify-between gap-4 border-t border-zinc-200 pt-6 text-sm dark:border-zinc-800"
    aria-label={dictionary.paginationLabel}
  >
    <div class="min-w-20">
      {hasPrev && (
        <a class={edgeLink} href={pageHref(currentPage - 1)} rel="prev">← {dictionary.prevPage}</a>
      )}
    </div>
    <ol class="flex items-center gap-1">
      {pages.map((page) => (
        <li>
          {page === currentPage ? (
            <span
              aria-current="page"
              class="inline-flex h-8 min-w-8 items-center justify-center rounded-md bg-zinc-900 px-2 font-medium text-white dark:bg-zinc-100 dark:text-zinc-900"
            >
              {page}
            </span>
          ) : (
            <a
              class="inline-flex h-8 min-w-8 items-center justify-center rounded-md px-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
              href={pageHref(page)}
            >
              {page}
            </a>
          )}
        </li>
      ))}
    </ol>
    <div class="min-w-20 text-right">
      {hasNext && (
        <a class={edgeLink} href={pageHref(currentPage + 1)} rel="next">{dictionary.nextPage} →</a>
      )}
    </div>
  </nav>
)}
