---
import { getTaxonomyRouteEntries, getTaxonomyTermLocaleAlternates, getTaxonomyTermParam, type PostRouteEntry } from '../../../../../content/posts';
import { adsenseListSlot, postsPerPage, type Locale } from '../../../../../config/site';
import { dictionaries } from '../../../../../i18n/dictionaries';
import SiteShell from '../../../../../layouts/SiteShell.astro';
import AdUnit from '../../../../../components/AdUnit.astro';
import Pagination from '../../../../../components/Pagination.astro';

export async function getStaticPaths() {
  const entries = await getTaxonomyRouteEntries('tags');
  const paths = [];

  for (const { locale, term, posts } of entries) {
    const totalPages = Math.ceil(posts.length / postsPerPage);

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { locale, term, page: String(page) },
        props: {
          locale,
          term,
          posts: posts.slice((page - 1) * postsPerPage, page * postsPerPage),
          currentPage: page,
          totalPages,
        },
      });
    }
  }

  return paths;
}

const { locale, term, posts, currentPage, totalPages } = Astro.props as {
  locale: Locale;
  term: string;
  posts: PostRouteEntry[];
  currentPage: number;
  totalPages: number;
};
const dictionary = dictionaries[locale];
const heading = `${dictionary.tagLabel}: ${term}`;
const basePath = `/${locale}/tags/${getTaxonomyTermParam(term)}`;
const localeAlternates = await getTaxonomyTermLocaleAlternates('tags', term);
---

<SiteShell locale={locale} pageTitle={heading} localeAlternates={localeAlternates}>
  <section class="space-y-6">
    <h1 class="text-4xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">{heading}</h1>

    {posts.length > 0 ? (
      posts.map(({ entry, slug }) => (
        <article class="space-y-2">
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
            <a class="underline-offset-4 hover:underline" href={`/${locale}/posts/${slug}/`}>{entry.data.title}</a>
          </h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">{entry.data.date.toISOString().slice(0, 10)}</p>
          {entry.data.description && (
            <p class="text-base leading-7 text-zinc-700 dark:text-zinc-300">{entry.data.description}</p>
          )}
        </article>
      ))
    ) : (
      <p class="text-base text-zinc-600 dark:text-zinc-400">{dictionary.emptyTaxonomy}</p>
    )}
    <Pagination locale={locale} basePath={basePath} currentPage={currentPage} totalPages={totalPages} />
    <AdUnit adSlot={adsenseListSlot} class="mt-6" />
  </section>
</SiteShell>
