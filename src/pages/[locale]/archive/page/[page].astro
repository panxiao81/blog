---
import SiteShell from '../../../../layouts/SiteShell.astro';
import AdUnit from '../../../../components/AdUnit.astro';
import { getLocalePostListItems, getTaxonomyTermHref } from '../../../../content/posts';
import { adsenseListSlot, localeLabels, locales, postsPerPage, type Locale } from '../../../../config/site';
import { dictionaries } from '../../../../i18n/dictionaries';

export async function getStaticPaths() {
  const paths = [];

  for (const locale of locales) {
    const posts = await getLocalePostListItems(locale);
    const totalPages = Math.ceil(posts.length / postsPerPage);

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { locale, page: String(page) },
        props: {
          locale,
          posts: posts.slice((page - 1) * postsPerPage, page * postsPerPage),
        },
      });
    }
  }

  return paths;
}

const { locale, posts } = Astro.props as {
  locale: Locale;
  posts: Awaited<ReturnType<typeof getLocalePostListItems>>;
};
const dictionary = dictionaries[locale];
---

<SiteShell locale={locale} pageTitle={dictionary.archive}>
  <section class="space-y-6">
    <h1 class="text-4xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">{dictionary.archive}</h1>

    {posts.map(({ entry, slug, sourceLocale, kind }) => (
      <article class="space-y-2 border-b border-zinc-200 dark:border-zinc-800 pb-4 last:border-b-0">
        <h2 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">
          <a class="underline-offset-4 hover:underline" href={`/${sourceLocale}/posts/${slug}/`}>{entry.data.title}</a>
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">{entry.data.date.toISOString().slice(0, 10)}</p>
        {kind === 'placeholder' && (
          <p class="text-sm text-zinc-500 dark:text-zinc-400">{localeLabels[sourceLocale]}</p>
        )}
        {entry.data.tags.length > 0 && (
          <p class="text-sm text-zinc-700 dark:text-zinc-300">
            <span class="font-medium">{dictionary.tags}:</span>{' '}
            {entry.data.tags.map((term: string, index: number) => (
              <>
                {index > 0 && ', '}
                <a class="underline-offset-4 hover:underline" href={getTaxonomyTermHref(sourceLocale, 'tags', term)}>{term}</a>
              </>
            ))}
          </p>
        )}
        {entry.data.categories.length > 0 && (
          <p class="text-sm text-zinc-700 dark:text-zinc-300">
            <span class="font-medium">{dictionary.categories}:</span>{' '}
            {entry.data.categories.map((term: string, index: number) => (
              <>
                {index > 0 && ', '}
                <a class="underline-offset-4 hover:underline" href={getTaxonomyTermHref(sourceLocale, 'categories', term)}>{term}</a>
              </>
            ))}
          </p>
        )}
        {entry.data.series.length > 0 && (
          <p class="text-sm text-zinc-700 dark:text-zinc-300">
            <span class="font-medium">{dictionary.series}:</span>{' '}
            {entry.data.series.map((term: string, index: number) => (
              <>
                {index > 0 && ', '}
                <a class="underline-offset-4 hover:underline" href={getTaxonomyTermHref(sourceLocale, 'series', term)}>{term}</a>
              </>
            ))}
          </p>
        )}
      </article>
    ))}
    <AdUnit adSlot={adsenseListSlot} class="mt-6" />
  </section>
</SiteShell>
