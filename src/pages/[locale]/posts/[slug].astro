---
import { render } from 'astro:content';

import { adsensePostSlot, defaultLicenseUrl, localeLabels, siteUrl, utterancesRepo, type Locale } from '../../../config/site';
import AdUnit from '../../../components/AdUnit.astro';
import {
  getAdjacentPosts,
  getPostLocaleAlternates,
  getPostRouteEntries,
  getSourcePostForSlug,
  getTaxonomyTermHref,
  type PostRouteEntry,
} from '../../../content/posts';
import { dictionaries } from '../../../i18n/dictionaries';
import SiteShell from '../../../layouts/SiteShell.astro';

export async function getStaticPaths() {
  const posts = await getPostRouteEntries();

  return Promise.all(
    posts.map(async ({ entry, locale, slug }: PostRouteEntry) => {
      const { newer, older } = await getAdjacentPosts(locale, slug);

      return {
        params: { locale, slug },
        props: { post: entry, locale, newer, older },
      };
    }),
  );
}

const {
  post,
  locale,
  newer,
  older,
} = Astro.props as {
  post: PostRouteEntry['entry'];
  locale: Locale;
  newer: PostRouteEntry | null;
  older: PostRouteEntry | null;
};
const { slug } = Astro.params;
const { Content, headings } = await render(post);
const dictionary = dictionaries[locale];
const publishedDate = post.data.date.toISOString().slice(0, 10);
const tocHeadings = headings.filter((h: { depth: number; slug: string; text: string }) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length > 0;
const commentKey = `posts/${post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '')}/`;
const licenseLabel = post.data.license ?? dictionary.licenseLabel;
const licenseUrl = post.data.license ? undefined : defaultLicenseUrl;

const allPosts = siteUrl ? await getPostRouteEntries() : [];
const hreflangAlternates = siteUrl
  ? allPosts
      .filter((p) => p.slug === slug)
      .map((p) => ({ locale: p.locale, url: `${siteUrl}/${p.locale}/posts/${p.slug}/` }))
  : undefined;
const localeAlternates = await getPostLocaleAlternates(slug);

// For a machine-translated post, point readers back to the author-written
// original. Skip the link when the source is this same version (e.g. a slug with
// no separate source marked), since there is nothing else to link to.
const original = post.data.autoTranslated ? await getSourcePostForSlug(slug) : null;
const originalHref = original && original.locale !== locale ? `/${original.locale}/posts/${original.slug}/` : null;
---

<SiteShell
  locale={locale}
  pageTitle={post.data.title}
  description={post.data.description}
  hreflangAlternates={hreflangAlternates}
  localeAlternates={localeAlternates}
  ogType="article"
>
  <div class="lg:flex lg:gap-16 xl:gap-20">
    <article class="min-w-0 flex-1 space-y-12">
      <header class="max-w-[68ch] space-y-6">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">Post</p>
        <h1 class="max-w-[12ch] text-balance text-[clamp(2.75rem,5vw,4.5rem)] font-semibold leading-[0.95] tracking-[-0.04em] text-zinc-950 dark:text-zinc-50">{post.data.title}</h1>
        <div class="space-y-2.5 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
          <time class="block" datetime={publishedDate}>{publishedDate}</time>

          {post.data.tags.length > 0 && (
            <p>
              <span class="font-medium text-zinc-800 dark:text-zinc-200">{dictionary.tags}:</span>{' '}
              {post.data.tags.map((term: string, index: number) => (
                <>
                  {index > 0 && ', '}
                  <a class="underline-offset-4 hover:underline" href={getTaxonomyTermHref(locale, 'tags', term)}>{term}</a>
                </>
              ))}
            </p>
          )}
          {post.data.categories.length > 0 && (
            <p>
              <span class="font-medium text-zinc-800 dark:text-zinc-200">{dictionary.categories}:</span>{' '}
              {post.data.categories.map((term: string, index: number) => (
                <>
                  {index > 0 && ', '}
                  <a class="underline-offset-4 hover:underline" href={getTaxonomyTermHref(locale, 'categories', term)}>{term}</a>
                </>
              ))}
            </p>
          )}
          {post.data.series.length > 0 && (
            <p>
              <span class="font-medium text-zinc-800 dark:text-zinc-200">{dictionary.series}:</span>{' '}
              {post.data.series.map((term: string, index: number) => (
                <>
                  {index > 0 && ', '}
                  <a class="underline-offset-4 hover:underline" href={getTaxonomyTermHref(locale, 'series', term)}>{term}</a>
                </>
              ))}
            </p>
          )}
        </div>

        {post.data.autoTranslated && (
          <p class="max-w-[68ch] rounded border border-amber-200 dark:border-amber-700 bg-amber-50 dark:bg-amber-950 px-3 py-2.5 text-sm leading-6 text-amber-800 dark:text-amber-300">
            {dictionary.translationNotice}
            {original && originalHref && (
              <>
                {' '}
                <a class="font-medium underline underline-offset-4 hover:no-underline" href={originalHref}>
                  {dictionary.viewOriginal} ({localeLabels[original.locale]})
                </a>
              </>
            )}
          </p>
        )}

        {hasToc && (
          <div class="lg:hidden">
            <button
              type="button"
              id="toc-toggle"
              aria-expanded="false"
              aria-controls="toc-mobile"
              class="inline-flex min-h-11 items-center gap-1 rounded-md text-sm leading-6 text-zinc-600 underline-offset-4 transition-colors hover:text-zinc-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 dark:focus-visible:outline-zinc-100"
            >
              {dictionary.tocToggleLabel}
            </button>
            <nav id="toc-mobile" hidden aria-label={dictionary.tocHeading} class="mt-3 space-y-1.5 border-l border-zinc-200 pl-4 text-sm leading-6 dark:border-zinc-700">
              {tocHeadings.map((h: { depth: number; slug: string; text: string }) => (
                <a
                  href={`#${h.slug}`}
                  class={`block text-zinc-600 dark:text-zinc-400 underline-offset-4 hover:underline ${h.depth === 3 ? 'pl-4' : ''}`}
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>
        )}
      </header>

      <div class="prose prose-zinc max-w-[68ch] text-[1.0625rem] leading-8 dark:prose-invert prose-headings:text-balance prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-zinc-950 dark:prose-headings:text-zinc-50 prose-h2:mt-16 prose-h2:mb-5 prose-h2:text-[clamp(1.75rem,3vw,2.4rem)] prose-h2:leading-[1.08] prose-h2:scroll-mt-24 prose-h3:mt-10 prose-h3:mb-4 prose-h3:text-[1.35rem] prose-h3:leading-[1.2] prose-p:text-zinc-700 dark:prose-p:text-zinc-300 prose-p:leading-8 prose-li:text-zinc-700 dark:prose-li:text-zinc-300 prose-li:leading-8 prose-strong:text-zinc-950 dark:prose-strong:text-zinc-100 prose-a:font-medium prose-a:text-zinc-900 dark:prose-a:text-zinc-100 prose-a:decoration-zinc-300 dark:prose-a:decoration-zinc-700 prose-code:text-[0.95em] prose-pre:rounded-xl prose-pre:border prose-pre:border-zinc-200 prose-pre:bg-zinc-950 dark:prose-pre:border-zinc-800 dark:prose-pre:bg-zinc-950 prose-blockquote:border-zinc-300 prose-blockquote:text-zinc-700 dark:prose-blockquote:border-zinc-700 dark:prose-blockquote:text-zinc-300 prose-hr:border-zinc-200 dark:prose-hr:border-zinc-800">
        <Content />
      </div>

      <AdUnit adSlot={adsensePostSlot} class="max-w-[68ch] mt-8" />

      <footer class="max-w-[68ch] border-t border-zinc-200 pt-4 text-sm leading-6 text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
        {licenseUrl ? (
          <a class="underline-offset-4 hover:underline" href={licenseUrl} target="_blank" rel="noopener noreferrer">{licenseLabel}</a>
        ) : (
          <span>{licenseLabel}</span>
        )}
      </footer>

      <!-- Newer / Older navigation -->
      {(newer || older) && (
        <nav class="max-w-[68ch] grid gap-6 border-t border-zinc-200 pt-6 text-sm dark:border-zinc-800 md:grid-cols-2" aria-label="Post navigation">
          <div class="min-h-16">
            {older && (
              <a class="group flex h-full flex-col justify-between gap-1 rounded-lg underline-offset-4 transition-colors hover:text-zinc-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:hover:text-zinc-100 dark:focus-visible:outline-zinc-100" href={`/${locale}/posts/${older.slug}/`}>
                <span class="text-zinc-500 dark:text-zinc-400">{dictionary.olderPost}</span>
                <span class="font-medium leading-6 text-zinc-900 dark:text-zinc-100">{older.entry.data.title}</span>
              </a>
            )}
          </div>
          <div class="min-h-16 md:text-right">
            {newer && (
              <a class="group flex h-full flex-col justify-between gap-1 rounded-lg underline-offset-4 transition-colors hover:text-zinc-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:items-end dark:hover:text-zinc-100 dark:focus-visible:outline-zinc-100 md:items-end" href={`/${locale}/posts/${newer.slug}/`}>
                <span class="text-zinc-500 dark:text-zinc-400">{dictionary.newerPost}</span>
                <span class="font-medium leading-6 text-zinc-900 dark:text-zinc-100">{newer.entry.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}

      <section aria-label="Comments" class="max-w-[68ch] mt-8">
        <script
          src="https://utteranc.es/client.js"
          data-repo={utterancesRepo}
          data-issue-term={commentKey}
          data-theme="preferred-color-scheme"
          crossorigin="anonymous"
          async
          is:inline
        ></script>
      </section>
    </article>

    <!-- Desktop sidebar TOC -->
    {hasToc && (
      <aside class="hidden lg:block lg:w-56 xl:w-64">
        <nav aria-label={dictionary.tocHeading} class="sticky top-8 space-y-1 border-l border-zinc-200 pl-5 dark:border-zinc-800">
          <p class="mb-3 text-sm font-semibold text-zinc-900 dark:text-zinc-100">{dictionary.tocHeading}</p>
          {tocHeadings.map((h: { depth: number; slug: string; text: string }) => (
            <a
              href={`#${h.slug}`}
              class={`block text-sm leading-6 text-zinc-600 underline-offset-4 transition-colors hover:text-zinc-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 dark:focus-visible:outline-zinc-100 ${h.depth === 3 ? 'pl-4' : ''}`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</SiteShell>

<script is:inline>
  (function () {
    const toggle = document.getElementById('toc-toggle');
    const panel = document.getElementById('toc-mobile');

    if (!toggle || !panel) return;

    toggle.addEventListener('click', function () {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';

      panel.hidden = expanded;
      toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    });
  })();
</script>

<script is:inline>
  (function () {
    document.querySelectorAll('pre > code').forEach(function (codeEl) {
      const pre = codeEl.parentElement;

      if (!pre || pre.querySelector('[data-copy-code]')) return;

      const btn = document.createElement('button');

      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code');
      btn.setAttribute('data-copy-code', 'true');
      btn.className = 'absolute right-3 top-3 inline-flex min-h-9 items-center rounded-md border border-zinc-700 bg-zinc-900/90 px-2.5 text-xs font-medium text-zinc-100 shadow-sm transition-colors hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-100 dark:border-zinc-600 dark:bg-zinc-900 dark:hover:bg-zinc-800';

      if (getComputedStyle(pre).position === 'static') {
        pre.style.position = 'relative';
      }

      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(codeEl.textContent || '').then(function () {
          btn.textContent = 'Copied';
          setTimeout(function () {
            btn.textContent = 'Copy';
          }, 1500);
        });
      });

      pre.appendChild(btn);
    });
  })();
</script>

<script type="module" is:inline>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  const codeBlocks = Array.from(document.querySelectorAll('pre > code')).filter(function (codeEl) {
    const source = (codeEl.textContent || '').trim();

    return /^(graph|flowchart|sequenceDiagram|classDiagram|stateDiagram|erDiagram|journey|gantt|pie|mindmap|timeline|gitGraph)\b/.test(source);
  });

  if (codeBlocks.length > 0) {
    const mermaidTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'neutral';

    mermaid.initialize({ startOnLoad: false, theme: mermaidTheme });

    codeBlocks.forEach(function (codeEl) {
      const pre = codeEl.parentElement;

      if (!pre) return;

      const div = document.createElement('div');

      div.className = 'mermaid';
      div.textContent = codeEl.textContent || '';
      pre.replaceWith(div);
    });

    mermaid.run({ querySelector: '.mermaid' });
  }
</script>
