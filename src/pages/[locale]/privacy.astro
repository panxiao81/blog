---
import type { MarkdownInstance } from 'astro';

import SiteShell from '../../layouts/SiteShell.astro';
import { locales, type Locale } from '../../config/site';
import { dictionaries } from '../../i18n/dictionaries';

type MarkdownPageModule = MarkdownInstance<{
  title: string;
}>;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const dictionary = dictionaries[locale];
const pageModules = import.meta.glob('../../content/pages/privacy/*.md');
const loadPage = pageModules[`../../content/pages/privacy/${locale}.md`];

if (!loadPage) {
  throw new Error(`Missing Privacy page for locale: ${locale}`);
}

const page = await loadPage() as MarkdownPageModule;
const { Content, frontmatter } = page;
---

<SiteShell locale={locale} pageTitle={frontmatter.title}>
  <article class="prose prose-zinc max-w-none">
    <Content />
  </article>
  <div class="mt-6 border-t border-zinc-200 pt-4">
    <button type="button" data-consent-reopen class="text-sm text-zinc-600 underline-offset-4 hover:underline">
      {dictionary.privacySettings}
    </button>
  </div>
</SiteShell>
