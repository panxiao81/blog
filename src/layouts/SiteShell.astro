---
import '../styles/global.css';

import { siteConfig, siteUrl, siteFoundingYear, gtagId, adsenseId, consentStorageKey, locales, localeLabels, themePreferenceStorageKey, externalMenuLinks, type Locale } from '../config/site';
import { dictionaries } from '../i18n/dictionaries';

interface Props {
  locale: Locale;
  pageTitle?: string;
  description?: string;
  hreflangAlternates?: Array<{ locale: string; url: string }>;
  ogType?: 'website' | 'article';
}

const { locale, pageTitle, description, hreflangAlternates, ogType = 'website' } = Astro.props;
const dictionary = dictionaries[locale];
const title = pageTitle ? `${pageTitle} | ${siteConfig.title}` : siteConfig.title;
const themeStorageKey = themePreferenceStorageKey;
const pageDescription = description ?? siteConfig.description;
const canonicalUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const currentYear = new Date().getFullYear();
const yearRange = currentYear > siteFoundingYear
  ? `${siteFoundingYear}–${currentYear}`
  : String(siteFoundingYear);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {hreflangAlternates?.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.url} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {siteUrl && <meta property="og:image" content={`${siteUrl}/og-default.svg`} />}
    {gtagId && (
      <>
        <script is:inline define:vars={{ gtagId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(...args){dataLayer.push(args);}
          gtag('consent', 'default', {
            ad_storage: 'denied', analytics_storage: 'denied',
            ad_user_data: 'denied', ad_personalization: 'denied',
            wait_for_update: 500,
          });
          gtag('js', new Date());
          gtag('config', gtagId);
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
      </>
    )}
    {adsenseId && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`} crossorigin="anonymous"></script>
    )}
    <script data-theme-init is:inline define:vars={{ themeStorageKey }}>
      (function () {
        let stored;
        try {
          stored = localStorage.getItem(themeStorageKey);
        } catch {
          stored = null;
        }
        const isDark = stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 antialiased">
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-8">
      <header class="border-b border-zinc-200 dark:border-zinc-800 pb-5">
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <a class="text-lg font-semibold tracking-tight" href={`/${locale}/`}>{siteConfig.title}</a>
            <div class="flex flex-wrap items-center gap-3 md:justify-end">
              <form
                role="search"
                aria-label={dictionary.searchLabel}
                action="https://www.google.com/search"
                method="get"
                target="_blank"
                data-search="desktop"
                class="hidden md:flex items-center gap-1"
              >
                <input type="hidden" name="sitesearch" value={siteUrl} />
                <input
                  type="search"
                  name="q"
                  placeholder={dictionary.searchPlaceholder}
                  aria-label={dictionary.searchLabel}
                  class="w-44 rounded border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 px-2 py-1 text-sm focus:outline-none"
                />
              </form>
              <nav aria-label="Language" class="flex items-center gap-2 text-sm">
                {locales.map((l) =>
                  l === locale
                    ? <span aria-current="page" class="font-semibold text-zinc-900 dark:text-zinc-100">{localeLabels[l]}</span>
                    : <a href={`/${l}/`} class="text-zinc-500 dark:text-zinc-400 underline-offset-4 hover:underline">{localeLabels[l]}</a>
                )}
              </nav>
              <nav aria-label="Theme" class="inline-flex items-center gap-1 rounded-full border border-zinc-200 p-1 text-sm dark:border-zinc-800">
                <button type="button" data-theme="light" class="rounded-full px-2.5 py-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100">{dictionary.themeLight}</button>
                <button type="button" data-theme="dark" class="rounded-full px-2.5 py-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100">{dictionary.themeDark}</button>
                <button type="button" data-theme="system" class="rounded-full px-2.5 py-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100">{dictionary.themeSystem}</button>
              </nav>
              <button
                type="button"
                data-search="mobile-toggle"
                aria-expanded="false"
                aria-controls="mobile-search"
                aria-label={dictionary.searchToggleLabel}
                class="md:hidden p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100"
              >
                &#x1F50D;
              </button>
            </div>
          </div>
          <nav aria-label="Main Navigation" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            <a class="text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:underline" href={`/${locale}/archive/`}>{dictionary.archive}</a>
            <a class="text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:underline" href={`/${locale}/about/`}>{dictionary.about}</a>
            <a class="text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:underline" href={`/${locale}/series/`}>{dictionary.series}</a>
            <a class="text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:underline" href={`/${locale}/categories/`}>{dictionary.categories}</a>
            <details data-more-menu class="relative">
              <summary class="list-none cursor-pointer text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:underline [&::-webkit-details-marker]:hidden">{dictionary.more}</summary>
              <div class="absolute left-0 top-full z-10 mt-2 min-w-56 rounded-md border border-zinc-200 bg-white p-2 shadow-lg dark:border-zinc-800 dark:bg-zinc-950">
                <a class="block rounded px-2 py-1.5 text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:bg-zinc-100 hover:underline dark:hover:bg-zinc-900" href={`/${locale}/series/`}>{dictionary.series}</a>
                <a class="block rounded px-2 py-1.5 text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:bg-zinc-100 hover:underline dark:hover:bg-zinc-900" href={`/${locale}/categories/`}>{dictionary.categories}</a>
                <a class="block rounded px-2 py-1.5 text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:bg-zinc-100 hover:underline dark:hover:bg-zinc-900" href={`/${locale}/links/`}>{dictionary.links}</a>
                <div class="my-2 border-t border-zinc-200 dark:border-zinc-800"></div>
                {externalMenuLinks.map((link) => (
                  <a
                    class="flex items-center justify-between gap-3 rounded px-2 py-1.5 text-zinc-700 dark:text-zinc-300 underline-offset-4 hover:bg-zinc-100 hover:underline dark:hover:bg-zinc-900"
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>{link.label}</span>
                    {link.chineseOnly && (
                      <span class="shrink-0 rounded-full border border-zinc-200 px-2 py-0.5 text-[11px] text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">{dictionary.chineseOnly}</span>
                    )}
                  </a>
                ))}
              </div>
            </details>
          </nav>
        </div>
      </header>
      <main class="flex-1 py-10">
        <slot />
      </main>
      <footer class="flex items-center justify-between gap-3 border-t border-zinc-200 dark:border-zinc-800 pt-4 text-sm text-zinc-600 dark:text-zinc-400">
        <span>© {yearRange} {siteConfig.title}</span>
        <nav aria-label="Footer" class="flex items-center gap-3">
          <a class="underline-offset-4 hover:underline" href={`/${locale}/privacy/`}>{dictionary.privacy}</a>
          <button type="button" data-consent-reopen class="underline-offset-4 hover:underline">{dictionary.privacySettings}</button>
          <a class="underline-offset-4 hover:underline" href={`/${locale}/rss.xml`}>{dictionary.rssLabel}</a>
        </nav>
      </footer>
    </div>
    <div id="mobile-search" data-search="mobile" hidden class="border-b border-zinc-200 dark:border-zinc-800 dark:bg-zinc-950 px-6 py-3">
      <form
        role="search"
        aria-label={dictionary.searchLabel}
        action="https://www.google.com/search"
        method="get"
        target="_blank"
      >
        <input type="hidden" name="sitesearch" value={siteUrl} />
        <input
          type="search"
          name="q"
          placeholder={dictionary.searchPlaceholder}
          aria-label={dictionary.searchLabel}
          class="w-full rounded border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-500 px-2 py-1 text-sm focus:outline-none"
        />
      </form>
    </div>
    <script data-search-toggle is:inline>
      (function () {
        const toggle = document.querySelector('[data-search="mobile-toggle"]');
        const panel = document.querySelector('#mobile-search');
        if (!toggle || !panel) return;
        toggle.addEventListener('click', function () {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          panel.hidden = expanded;
          toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        });
      })();
    </script>
    <script data-more-menu is:inline>
      (function () {
        const menus = Array.from(document.querySelectorAll('[data-more-menu]'));
        if (!menus.length) return;

        document.addEventListener('click', function (event) {
          if (!(event.target instanceof Node)) return;
          menus.forEach(function (menu) {
            if (menu.contains(event.target)) return;
            menu.removeAttribute('open');
          });
        });

        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          menus.forEach(function (menu) {
            menu.removeAttribute('open');
          });
        });
      })();
    </script>
    <script data-theme-interact is:inline define:vars={{ themeStorageKey }}>
      (function () {
        function applyTheme(value) {
          const isDark = value === 'dark' ||
            (value !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          document.querySelectorAll('[data-theme]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', btn.getAttribute('data-theme') === value ? 'true' : 'false');
          });
        }

        let stored;
        try {
          stored = localStorage.getItem(themeStorageKey);
        } catch {
          stored = null;
        }
        applyTheme(stored || 'system');

        document.querySelectorAll('[data-theme]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const theme = btn.getAttribute('data-theme');
            try {
              localStorage.setItem(themeStorageKey, theme);
            } catch {
              // Ignore storage failures and still apply the theme for this page load.
            }
            applyTheme(theme);
          });
        });
      })();
    </script>
    <div
      id="consent-banner"
      hidden
      class="fixed bottom-0 inset-x-0 z-50 border-t border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-6 py-4 shadow-lg"
    >
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-zinc-700 dark:text-zinc-300">{dictionary.consentMessage}</p>
        <div class="flex gap-3">
          <button
            id="consent-accept"
            type="button"
            class="rounded bg-zinc-900 dark:bg-zinc-100 px-4 py-2 text-sm text-white dark:text-zinc-900 hover:bg-zinc-700 dark:hover:bg-zinc-300"
          >
            {dictionary.consentAccept}
          </button>
          <button
            id="consent-decline"
            type="button"
            class="rounded border border-zinc-300 dark:border-zinc-700 px-4 py-2 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800"
          >
            {dictionary.consentDecline}
          </button>
        </div>
      </div>
    </div>
    <script data-consent is:inline define:vars={{ consentStorageKey }}>
      (function () {
        const KEY = consentStorageKey;
        let stored;
        try { stored = localStorage.getItem(KEY); } catch { stored = null; }

        if (stored === 'granted' && typeof gtag !== 'undefined') {
          gtag('consent', 'update', {
            ad_storage: 'granted', analytics_storage: 'granted',
            ad_user_data: 'granted', ad_personalization: 'granted',
          });
        }

        const banner = document.getElementById('consent-banner');
        if (!stored && banner) banner.hidden = false;

        function save(choice) {
          try { localStorage.setItem(KEY, choice); } catch { /* storage unavailable */ }
          if (choice === 'granted' && typeof gtag !== 'undefined') {
            gtag('consent', 'update', {
              ad_storage: 'granted', analytics_storage: 'granted',
              ad_user_data: 'granted', ad_personalization: 'granted',
            });
          }
          if (banner) banner.hidden = true;
        }

        const acceptBtn = document.getElementById('consent-accept');
        const declineBtn = document.getElementById('consent-decline');
        if (acceptBtn) acceptBtn.addEventListener('click', function () { save('granted'); });
        if (declineBtn) declineBtn.addEventListener('click', function () { save('denied'); });

        document.querySelectorAll('[data-consent-reopen]').forEach(function (el) {
          el.addEventListener('click', function () { if (banner) banner.hidden = false; });
        });
      })();
    </script>
  </body>
</html>
