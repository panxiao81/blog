---
import '../styles/global.css';

import { siteConfig, siteUrl, siteFoundingYear, gtagId, adsenseId, consentStorageKey, locales, localeLabels, themePreferenceStorageKey, type Locale } from '../config/site';
import { dictionaries } from '../i18n/dictionaries';

interface Props {
  locale: Locale;
  pageTitle?: string;
  description?: string;
  hreflangAlternates?: Array<{ locale: string; url: string }>;
  ogType?: 'website' | 'article';
}

const { locale, pageTitle, description, hreflangAlternates, ogType = 'website' } = Astro.props;
const dictionary = dictionaries[locale];
const title = pageTitle ? `${pageTitle} | ${siteConfig.title}` : siteConfig.title;
const themeStorageKey = themePreferenceStorageKey;
const pageDescription = description ?? siteConfig.description;
const canonicalUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const currentYear = new Date().getFullYear();
const yearRange = currentYear > siteFoundingYear
  ? `${siteFoundingYear}–${currentYear}`
  : String(siteFoundingYear);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {hreflangAlternates?.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.url} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {siteUrl && <meta property="og:image" content={`${siteUrl}/og-default.svg`} />}
    {gtagId && (
      <>
        <script is:inline define:vars={{ gtagId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(...args){dataLayer.push(args);}
          gtag('consent', 'default', {
            ad_storage: 'denied', analytics_storage: 'denied',
            ad_user_data: 'denied', ad_personalization: 'denied',
            wait_for_update: 500,
          });
          gtag('js', new Date());
          gtag('config', gtagId);
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
      </>
    )}
    {adsenseId && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseId}`} crossorigin="anonymous"></script>
    )}
    <script data-theme-init is:inline define:vars={{ themeStorageKey }}>
      (function () {
        let stored;
        try {
          stored = localStorage.getItem(themeStorageKey);
        } catch {
          stored = null;
        }
        const isDark = stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white text-zinc-900 antialiased">
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6 py-8">
      <header class="border-b border-zinc-200 pb-4">
        <div class="flex items-center justify-between gap-4">
          <a class="text-lg font-semibold tracking-tight" href={`/${locale}/`}>{siteConfig.title}</a>
          <nav aria-label="Main Navigation" class="flex items-center gap-3">
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/`}>{dictionary.home}</a>
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/archive/`}>{dictionary.archive}</a>
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/tags/`}>{dictionary.tags}</a>
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/categories/`}>{dictionary.categories}</a>
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/series/`}>{dictionary.series}</a>
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/about/`}>{dictionary.about}</a>
            <a class="text-sm text-zinc-700 underline-offset-4 hover:underline" href={`/${locale}/links/`}>{dictionary.links}</a>
          </nav>
          <nav aria-label="Language" class="flex items-center gap-2 text-sm">
            {locales.map((l) =>
              l === locale
                ? <span aria-current="page" class="font-semibold text-zinc-900">{localeLabels[l]}</span>
                : <a href={`/${l}/`} class="text-zinc-500 underline-offset-4 hover:underline">{localeLabels[l]}</a>
            )}
          </nav>
          <nav aria-label="Theme" class="flex items-center gap-1 text-sm">
            <button type="button" data-theme="light" class="px-2 py-1 text-zinc-500 hover:text-zinc-900">{dictionary.themeLight}</button>
            <button type="button" data-theme="dark" class="px-2 py-1 text-zinc-500 hover:text-zinc-900">{dictionary.themeDark}</button>
            <button type="button" data-theme="system" class="px-2 py-1 text-zinc-500 hover:text-zinc-900">{dictionary.themeSystem}</button>
          </nav>
          <form
            role="search"
            aria-label={dictionary.searchLabel}
            action="https://www.google.com/search"
            method="get"
            target="_blank"
            data-search="desktop"
            class="hidden sm:flex items-center gap-1"
          >
            <input type="hidden" name="sitesearch" value={siteUrl} />
            <input
              type="search"
              name="q"
              placeholder={dictionary.searchPlaceholder}
              aria-label={dictionary.searchLabel}
              class="w-40 rounded border border-zinc-300 px-2 py-1 text-sm focus:outline-none"
            />
          </form>
          <button
            type="button"
            data-search="mobile-toggle"
            aria-expanded="false"
            aria-controls="mobile-search"
            aria-label={dictionary.searchToggleLabel}
            class="sm:hidden p-1 text-zinc-500 hover:text-zinc-900"
          >
            &#x1F50D;
          </button>
        </div>
      </header>
      <main class="flex-1 py-10">
        <slot />
      </main>
      <footer class="flex items-center justify-between gap-3 border-t border-zinc-200 pt-4 text-sm text-zinc-600">
        <span>© {yearRange} {siteConfig.title}</span>
        <nav aria-label="Footer" class="flex items-center gap-3">
          <a class="underline-offset-4 hover:underline" href={`/${locale}/privacy/`}>{dictionary.privacy}</a>
          <button type="button" data-consent-reopen class="underline-offset-4 hover:underline">{dictionary.privacySettings}</button>
          <a class="underline-offset-4 hover:underline" href={`/${locale}/rss.xml`}>{dictionary.rssLabel}</a>
        </nav>
      </footer>
    </div>
    <div id="mobile-search" data-search="mobile" hidden class="border-b border-zinc-200 px-6 py-3">
      <form
        role="search"
        aria-label={dictionary.searchLabel}
        action="https://www.google.com/search"
        method="get"
        target="_blank"
      >
        <input type="hidden" name="sitesearch" value={siteUrl} />
        <input
          type="search"
          name="q"
          placeholder={dictionary.searchPlaceholder}
          aria-label={dictionary.searchLabel}
          class="w-full rounded border border-zinc-300 px-2 py-1 text-sm focus:outline-none"
        />
      </form>
    </div>
    <script data-search-toggle is:inline>
      (function () {
        const toggle = document.querySelector('[data-search="mobile-toggle"]');
        const panel = document.querySelector('#mobile-search');
        if (!toggle || !panel) return;
        toggle.addEventListener('click', function () {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          panel.hidden = expanded;
          toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        });
      })();
    </script>
    <script data-theme-interact is:inline define:vars={{ themeStorageKey }}>
      (function () {
        function applyTheme(value) {
          const isDark = value === 'dark' ||
            (value !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          document.querySelectorAll('[data-theme]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', btn.getAttribute('data-theme') === value ? 'true' : 'false');
          });
        }

        let stored;
        try {
          stored = localStorage.getItem(themeStorageKey);
        } catch {
          stored = null;
        }
        applyTheme(stored || 'system');

        document.querySelectorAll('[data-theme]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const theme = btn.getAttribute('data-theme');
            try {
              localStorage.setItem(themeStorageKey, theme);
            } catch {
              // Ignore storage failures and still apply the theme for this page load.
            }
            applyTheme(theme);
          });
        });
      })();
    </script>
    <div
      id="consent-banner"
      hidden
      class="fixed bottom-0 inset-x-0 z-50 border-t border-zinc-200 bg-white px-6 py-4 shadow-lg"
    >
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-zinc-700">{dictionary.consentMessage}</p>
        <div class="flex gap-3">
          <button
            id="consent-accept"
            type="button"
            class="rounded bg-zinc-900 px-4 py-2 text-sm text-white hover:bg-zinc-700"
          >
            {dictionary.consentAccept}
          </button>
          <button
            id="consent-decline"
            type="button"
            class="rounded border border-zinc-300 px-4 py-2 text-sm text-zinc-700 hover:bg-zinc-100"
          >
            {dictionary.consentDecline}
          </button>
        </div>
      </div>
    </div>
    <script data-consent is:inline define:vars={{ consentStorageKey }}>
      (function () {
        const KEY = consentStorageKey;
        let stored;
        try { stored = localStorage.getItem(KEY); } catch { stored = null; }

        if (stored === 'granted' && typeof gtag !== 'undefined') {
          gtag('consent', 'update', {
            ad_storage: 'granted', analytics_storage: 'granted',
            ad_user_data: 'granted', ad_personalization: 'granted',
          });
        }

        const banner = document.getElementById('consent-banner');
        if (!stored && banner) banner.hidden = false;

        function save(choice) {
          try { localStorage.setItem(KEY, choice); } catch { /* storage unavailable */ }
          if (choice === 'granted' && typeof gtag !== 'undefined') {
            gtag('consent', 'update', {
              ad_storage: 'granted', analytics_storage: 'granted',
              ad_user_data: 'granted', ad_personalization: 'granted',
            });
          }
          if (banner) banner.hidden = true;
        }

        const acceptBtn = document.getElementById('consent-accept');
        const declineBtn = document.getElementById('consent-decline');
        if (acceptBtn) acceptBtn.addEventListener('click', function () { save('granted'); });
        if (declineBtn) declineBtn.addEventListener('click', function () { save('denied'); });

        document.querySelectorAll('[data-consent-reopen]').forEach(function (el) {
          el.addEventListener('click', function () { if (banner) banner.hidden = false; });
        });
      })();
    </script>
  </body>
</html>
