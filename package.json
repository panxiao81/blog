{
  "name": "blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "cf-preview": "astro build && wrangler dev",
    "check": "astro check",
    "lint": "eslint .",
    "quality": "pnpm run lint && pnpm run check && pnpm run test:run && pnpm run build",
    "new-post": "node ./scripts/new-post.mjs",
    "import-posts": "node ./scripts/import-posts.mjs",
    "translate-post": "node ./scripts/translate-post.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^3.2.1",
    "openai": "^6.42.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.100.0"
  }
